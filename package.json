{
  "name": "cwf",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @cwf/web dev",
    "build": "pnpm --filter @cwf/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "invariants": "node scripts/invariants/run.mjs",
    "codegen": "node scripts/codegen/clients.mjs",
    "codegen:check": "node scripts/codegen/clients.mjs --check",
    "contracts:build": "forge build --root contracts --sizes && FOUNDRY_PROFILE=evm forge build --root contracts --sizes",
    "contracts:test": "forge test --root contracts --no-match-contract Fork",
    "db:migrate": "pnpm --filter @cwf/db migrate",
    "ops:start": "pnpm --filter @cwf/ops start",
    "ci": "pnpm typecheck && pnpm invariants && pnpm codegen:check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
