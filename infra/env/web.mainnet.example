# web (mainnet) — names only; set values in the Coolify app
NETWORK=mainnet
APP_ORIGIN=
PASSKEY_RP_ID=
# Build-time, public (D-228: the app at https://mitoshi.xyz, ops and the stream at ops./stream.mitoshi.xyz, the guides at
# docs.mitoshi.xyz; the rpId stays mitoshi.xyz)
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_APP_ORIGIN=
NEXT_PUBLIC_OPS_URL=
NEXT_PUBLIC_STREAM_URL=
NEXT_PUBLIC_DOCS_URL=
TEMPO_RPC_HTTP_URL=
TEMPO_RPC_WS_URL=
RH_RPC_HTTP_URL=
DATABASE_URL=
REDIS_URL=
RELAY_FEE_PAYER_PRIVATE_KEY=
DESK_PRIVATE_KEY=
OPS_INTERNAL_TOKEN=
STREAM_TICKET_SECRET=
SOCIAL_SESSION_SECRET=
MPP_SECRET_KEY=
WALLETCONNECT_PROJECT_ID=
# /download's store links (D-230; not NEXT_PUBLIC_*: the cards read them per request, so set and restart is enough; the
# loading skeleton reads them at build, so mark them build variables too and the next deploy draws the same shape).
# Unset or malformed, a card says "Coming to TestFlight" / "Coming to Google Play". Only Apple's /join/<code> and Google
# Play's test pages are taken; the internal test (invited testers) never leads the page.
TESTFLIGHT_PUBLIC_LINK=
PLAY_OPEN_TEST_LINK=
PLAY_INTERNAL_TEST_LINK=
# Sensei (S13, D-221): any one model key; SENSEI_MODEL / AI_MODEL name another model
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
SENSEI_MODEL=
SENSEI_VIA=
