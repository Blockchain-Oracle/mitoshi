MPP_ROOT_ADDRESS=
MPP_MAX_PER_REQUEST_BASE=
MPP_MAX_PER_DAY_BASE=
TEMPO_INDEXER_API_KEY=
TIDX_URL=
TIDX_BASIC_AUTH=
INDEXER_VIA_MPP=
# reference-writer (S15b, opt-in: add it to OPS_ACTORS)
KEEPER_PRIVATE_KEY=
# launch-keeper (S17b, R4-11, opt-in: add it to OPS_ACTORS): graduates Complete memecoins; signs with this key, else KEEPER_PRIVATE_KEY
LAUNCH_KEEPER_PRIVATE_KEY=
# theme-agent (S16a, R4-11, opt-in: add it to OPS_ACTORS): 64 hex chars (openssl rand -hex 32), ops only; seals each follower's theme key
THEME_KEYS_SECRET=
# agent brain (S9, D-221): any one model key; AI_MODEL names another model (default: Claude with its key, else openai/gpt-6-sol)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
AI_GATEWAY_API_KEY=
AGENT_VIA=
AGENT_MAX_CALLS_PER_HOUR=
AGENT_TIMEOUT_MS=
# x-relay (S11, D-227, opt-in: add it to OPS_ACTORS): the bot's handle and its ways in to X (the session first, the X API
# with the bot's user context second); dry until X_RELAY_LIVE=1 with DRY_RUN=0; replies only with X_POSTING_ENABLED=1,
# carrying the receipt card unless X_REPLY_IMAGES_ENABLED=0. The executor is X_EXECUTOR_PRIVATE_KEY, else the x-relay role key
X_HANDLE=
X_RETTIWT_API_KEY=
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
X_EXECUTOR_PRIVATE_KEY=
X_RELAY_PRIVATE_KEY=
X_RELAY_LIVE=
X_POSTING_ENABLED=
X_REPLY_IMAGES_ENABLED=
X_POLL_MS=
