# ops (testnet) — names only; set values in the Coolify app
NETWORK=testnet
TEMPO_RPC_HTTP_URL=
TEMPO_RPC_WS_URL=
RH_RPC_HTTP_URL=
DATABASE_URL=
REDIS_URL=
DRY_RUN=1
OPS_ACTORS=
OPS_INTERNAL_TOKEN=
STREAM_TICKET_SECRET=
ROLLER_PRIVATE_KEY=
PRICE_RELAY_PRIVATE_KEY=
SETTLER_PRIVATE_KEY=
SEED_MAKER_PRIVATE_KEY=
# S3 venue ops: data providers (the owner's own keys), CORS, optional knobs
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_ENDPOINT=
FINNHUB_API_KEY=
DATASTREAMS_API_KEY=
DATASTREAMS_API_SECRET=
