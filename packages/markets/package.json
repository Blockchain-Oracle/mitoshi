{
  "name": "@cwf/markets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "The only package that does chain I/O (viem/tempo, accounts, relay, submitter).",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./react": "./src/react/index.ts",
    "./v4": "./src/v4/encode.ts",
    "./launch": "./src/launch/stablecoin.ts",
    "./testing": "./src/testing/authorize-key.ts",
    "./env": "./src/env.ts",
    "./caps": "./src/sessions/caps.ts",
    "./errors": "./src/errors/index.ts",
    "./key-status": "./src/keys/status.ts",
    "./react-session": "./src/react/session-builder.tsx",
    "./stream": "./src/runtime/stream-hub.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@cwf/clients": "workspace:*",
    "@cwf/core": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "accounts": "catalog:",
    "ox": "catalog:",
    "redis": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
