    "./themes": "./src/themes/keyAuth.ts",
    "./tx/send": "./src/tx/send.ts",
    "./testing": "./src/testing/authorize-key.ts",
    "./env": "./src/env.ts",
    "./caps": "./src/sessions/caps.ts",
    "./errors": "./src/errors/index.ts",
    "./key-status": "./src/keys/status.ts",
    "./react-session": "./src/react/session-builder.tsx",
    "./stream": "./src/runtime/stream-hub.ts",
    "./live-ticks": "./src/runtime/live-ticks.ts",
    "./ops": "./src/ops/index.ts",
    "./parlay": "./src/parlay/index.ts",
    "./range": "./src/range/index.ts",
    "./leverage": "./src/leverage/index.ts",
    "./private": "./src/private/index.ts",
