{
  "name": "@cwf/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure domain logic: markets, orders, units, tx lifecycle, shell protocol. No I/O.",
  "exports": {
    ".": "./src/index.ts",
    "./venue-spec.json": "./src/market/venue-spec.json",
    "./stocks/guard": "./src/stocks/guard.ts",
    "./stocks/session": "./src/stocks/session.ts",
    "./prices/redstone": "./src/prices/redstonePayload.ts",
    "./stocks/housePlan": "./src/stocks/housePlan.ts",
    "./stocks/liquidity": "./src/stocks/liquidity.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
