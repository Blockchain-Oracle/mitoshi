{
  "note": "Shared golden vectors for EventVault's delegated-buy checks. ONE = 1e6; the mock book fills YES at 0.60 and NO at 0.40. `order.priceRaw` is the YES-terms limit the caller passes; both forge (contracts/test/products/vault/CapsVectors.t.sol) and vitest (caps.test.ts beside this file) assert every row. Rows 1-10 are Masayume 68f7a09 unchanged; rows 11-12 add the D-091 Window scope: `caps.market` is \"this\" (the order's Window), \"other\" (another listed Window) or absent (any Window, the contract's zero).",
  "count": 12,
  "vectors": [
    { "name": "in-cap buy fills", "caps": { "maxStakePerTrade": "50000000", "maxDailySpend": "100000000", "maxOpenPositions": 5, "maxPriceRaw": "0" }, "budget": "200000000", "expired": false, "prior": null, "order": { "outcomeIdx": 0, "priceRaw": "700000", "quantityRaw": "50000000" }, "expect": { "ok": true, "spendBase": "30000000" } },
    { "name": "per-trade cap on the actual charge", "caps": { "maxStakePerTrade": "10000000", "maxDailySpend": "100000000", "maxOpenPositions": 5, "maxPriceRaw": "0" }, "budget": "200000000", "expired": false, "prior": null, "order": { "outcomeIdx": 0, "priceRaw": "700000", "quantityRaw": "50000000" }, "expect": { "ok": false, "refusal": "stake", "error": "OverStakeCap" } },
    { "name": "budget must cover the escrow at the limit", "caps": { "maxStakePerTrade": "50000000", "maxDailySpend": "100000000", "maxOpenPositions": 5, "maxPriceRaw": "0" }, "budget": "20000000", "expired": false, "prior": null, "order": { "outcomeIdx": 0, "priceRaw": "700000", "quantityRaw": "50000000" }, "expect": { "ok": false, "refusal": "escrow", "error": "Insufficient" } },
    { "name": "daily cap counts today's earlier spend", "caps": { "maxStakePerTrade": "50000000", "maxDailySpend": "50000000", "maxOpenPositions": 9, "maxPriceRaw": "0" }, "budget": "500000000", "expired": false, "prior": { "outcomeIdx": 0, "priceRaw": "700000", "quantityRaw": "50000000" }, "order": { "outcomeIdx": 0, "priceRaw": "700000", "quantityRaw": "50000000" }, "expect": { "ok": false, "refusal": "daily", "error": "OverDailyCap" } },
    { "name": "price cap on YES", "caps": { "maxStakePerTrade": "50000000", "maxDailySpend": "500000000", "maxOpenPositions": 9, "maxPriceRaw": "650000" }, "budget": "500000000", "expired": false, "prior": null, "order": { "outcomeIdx": 0, "priceRaw": "700000", "quantityRaw": "10000000" }, "expect": { "ok": false, "refusal": "price", "error": "OverPriceCap" } },
    { "name": "price cap on NO reads the complement", "caps": { "maxStakePerTrade": "50000000", "maxDailySpend": "500000000", "maxOpenPositions": 9, "maxPriceRaw": "650000" }, "budget": "500000000", "expired": false, "prior": null, "order": { "outcomeIdx": 1, "priceRaw": "300000", "quantityRaw": "10000000" }, "expect": { "ok": false, "refusal": "price", "error": "OverPriceCap" } },
    { "name": "NO under the price cap fills", "caps": { "maxStakePerTrade": "50000000", "maxDailySpend": "500000000", "maxOpenPositions": 9, "maxPriceRaw": "650000" }, "budget": "500000000", "expired": false, "prior": null, "order": { "outcomeIdx": 1, "priceRaw": "400000", "quantityRaw": "10000000" }, "expect": { "ok": true, "spendBase": "4000000" } },
    { "name": "open-position cap counts a new side", "caps": { "maxStakePerTrade": "50000000", "maxDailySpend": "500000000", "maxOpenPositions": 1, "maxPriceRaw": "0" }, "budget": "500000000", "expired": false, "prior": { "outcomeIdx": 0, "priceRaw": "700000", "quantityRaw": "10000000" }, "order": { "outcomeIdx": 1, "priceRaw": "500000", "quantityRaw": "10000000" }, "expect": { "ok": false, "refusal": "positions", "error": "OverPositionCap" } },
    { "name": "expired grant", "caps": { "maxStakePerTrade": "50000000", "maxDailySpend": "500000000", "maxOpenPositions": 9, "maxPriceRaw": "0" }, "budget": "500000000", "expired": true, "prior": null, "order": { "outcomeIdx": 0, "priceRaw": "700000", "quantityRaw": "10000000" }, "expect": { "ok": false, "refusal": "expired", "error": "GrantExpired" } },
    { "name": "a limit under the book passes every cap and the venue refuses the empty IOC", "caps": { "maxStakePerTrade": "50000000", "maxDailySpend": "500000000", "maxOpenPositions": 9, "maxPriceRaw": "0" }, "budget": "500000000", "expired": false, "prior": null, "order": { "outcomeIdx": 0, "priceRaw": "500000", "quantityRaw": "10000000" }, "expect": { "ok": false, "refusal": "venue", "error": "ImmediateOrCancelNoFill" } },
    { "name": "a grant scoped to this Window fills (D-091)", "caps": { "maxStakePerTrade": "50000000", "maxDailySpend": "500000000", "maxOpenPositions": 9, "maxPriceRaw": "0", "market": "this" }, "budget": "500000000", "expired": false, "prior": null, "order": { "outcomeIdx": 0, "priceRaw": "700000", "quantityRaw": "10000000" }, "expect": { "ok": true, "spendBase": "6000000" } },
    { "name": "a grant scoped to another Window refuses before any price or budget check (D-091)", "caps": { "maxStakePerTrade": "50000000", "maxDailySpend": "500000000", "maxOpenPositions": 9, "maxPriceRaw": "650000", "market": "other" }, "budget": "1000000", "expired": false, "prior": null, "order": { "outcomeIdx": 0, "priceRaw": "700000", "quantityRaw": "10000000" }, "expect": { "ok": false, "refusal": "market", "error": "OutsideGrantMarket" } }
  ]
}
