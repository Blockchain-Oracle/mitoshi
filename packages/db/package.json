{
  "name": "@cwf/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Postgres client and ordered per-area migrations.",
  "exports": {
    ".": "./src/index.ts",
    "./idx": "./src/idx/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@cwf/core": "workspace:*",
    "@cwf/markets": "workspace:*",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  }
}
